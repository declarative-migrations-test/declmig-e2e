{
  "schema": "ores.common-desktop.capabilities/v1",
  "capabilities": {
    "consumer-validation": {
      "rust_module": "ores_common_desktop_daemon::consumer",
      "checker_binary": "ores-common-desktop-consumer-check"
    },
    "loopback-policy": {
      "rust_modules": [
        "ores_common_desktop_infra",
        "ores_common_desktop_cli",
        "ores_common_desktop_daemon"
      ]
    },
    "secret-file-policy": {
      "rust_modules": [
        "ores_common_desktop_cli",
        "ores_common_desktop_daemon"
      ]
    },
    "cloudflare-policy": {
      "rust_module": "ores_common_desktop_daemon::consumer"
    },
    "update-policy": {
      "rust_module": "ores_common_desktop_daemon"
    },
    "process-lifecycle": {
      "rust_module": "ores_common_desktop_daemon"
    },
    "health-readiness": {
      "rust_modules": [
        "ores_common_desktop_infra",
        "ores_common_desktop_daemon"
      ]
    },
    "structured-logging": {
      "rust_module": "ores_common_desktop_daemon::logging"
    },
    "desktop-auth-shell": {
      "flutter_package": "ores_common_mobile_host",
      "composition_seam": "OresDesktopAppShell.authenticated",
      "auth_provider": "shared-auth/shared-auth-flutter",
      "canonical_widget": "SharedAuthGate",
      "duplicated_auth_protocol": false
    },
    "mixed-compute-plane": {
      "rust_module": "ores_common_desktop_daemon::process_supervisor",
      "roles": [
        "standalone_server",
        "worker_supervisor",
        "lambda_worker"
      ]
    },
    "runtime-isolation": {
      "rust_module": "ores_common_desktop_daemon::process_supervisor",
      "erlang_modules": [
        "ores_common_desktop_router",
        "ores_common_desktop_middleware"
      ],
      "routing_compute_separation": true,
      "hot_reload_without_compute_restart": true
    },
    "generation-model": {
      "immutable_route_generation": true,
      "atomic_route_activation": true,
      "route_config_swap_distinct_from_code_reload": true,
      "request_generation_identity_exposed": true,
      "middleware_code_generation_pinning": false,
      "middleware_code_pinning_required_before_stable_promotion": true,
      "preferred_dynamic_code_runtime": "wasm"
    },
    "stable-ingress": {
      "templates": [
        "infra/ingress/nginx.conf.tmpl",
        "infra/ingress/haproxy.cfg.tmpl",
        "infra/ingress/Caddyfile.tmpl"
      ],
      "dynamic_application_routes_externalized": true,
      "caddy_admin_private_only": true,
      "authority_path": "infra/ingress",
      "duplicate_ingress_authorities": false
    },
    "cross-platform-packaging": {
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "templates": [
        "packaging/homebrew/ores-desktop-daemon.rb.tmpl",
        "packaging/macos/launchd.plist.tmpl",
        "packaging/linux/debian-control.tmpl",
        "packaging/linux/rpm.spec.tmpl",
        "packaging/linux/ores-desktop-daemon.service.tmpl",
        "packaging/linux/ores-desktop-daemon.user.service.tmpl",
        "packaging/winget/installer.yaml.tmpl",
        "packaging/scoop/manifest.json.tmpl",
        "packaging/windows/install-service.ps1.tmpl"
      ],
      "non_root_service_identities": true
    },
    "typed-mutation-auth": {
      "rust_module": "ores_common_desktop_daemon",
      "scopes": [
        "ores.desktop.lifecycle",
        "ores.desktop.deploy",
        "ores.desktop.update"
      ],
      "generic_deploy_update_forbidden": true,
      "generic_mutating_lifecycle_forbidden": true
    },
    "middleware-executor-isolation": {
      "erlang_modules": [
        "ores_common_desktop_middleware",
        "ores_common_desktop_middleware_handler"
      ],
      "per_request_process": true,
      "bounded_timeout": true,
      "beam_code_reload_requires_drain_or_otp_proof": true,
      "bounded_heap": true
    },
    "runtime-adapter-abi": {
      "rust_module": "ores_common_desktop_runtime",
      "operations": [
        "stage",
        "start",
        "health_check",
        "drain",
        "stop",
        "snapshot",
        "rollback"
      ],
      "validation": "fail_closed",
      "authority_path": "runtime/rust"
    },
    "immutable-deployment-bundle": {
      "rust_module": "ores_common_desktop_daemon::bundle",
      "secret_values_forbidden": true,
      "resource_limits_validated": true
    },
    "durable-generation-state": {
      "rust_module": "ores_common_desktop_state",
      "generation_fields": [
        "desired_generation",
        "staged_generation",
        "active_generation",
        "previous_generation"
      ],
      "operation_journal": true,
      "validated_on_load_and_store": true,
      "backup_recovery": true,
      "adapter_module": "ores_common_desktop_daemon::state::JsonOperationJournal"
    },
    "desktop-event-stream": {
      "rust_module": "ores_common_desktop_daemon::events"
    },
    "conformance-suite": {
      "path": "conformance/rust",
      "required": true,
      "rust_workspace_member": "ores-common-desktop-conformance"
    },
    "canonical-kernel": {
      "authorities": {
        "router": "router/rust",
        "runtime": "runtime/rust",
        "state": "state/rust",
        "auth": "auth/rust",
        "conformance": "conformance/rust"
      },
      "duplicate_runtime_authorities": false,
      "duplicate_auth_ui": false,
      "daemon_runtime_compatibility_reexport": "ores_common_desktop_runtime",
      "daemon_state_adapter": "JsonOperationJournal"
    },
    "hot-reload-backends": {
      "rust_module": "ores_common_desktop_infra::reload",
      "consumer_validator": "ores_common_desktop_daemon::hot_reload_policy",
      "route_backends": [
        "beam",
        "native_atomic",
        "external_process",
        "wasm_generation",
        "nginx_worker_generation",
        "haproxy_runtime",
        "caddy_admin"
      ],
      "middleware_code_reload": [
        "beam_hot_code",
        "process_generation",
        "wasm_generation",
        "declarative_only"
      ],
      "max_drain_timeout_ms": 86400000,
      "max_old_generations": 4,
      "proxy_admin_private_only": true,
      "proxy_managed_application_routes_default": false
    },
    "adaptive-backpressure-client": {
      "rust_module": "ores_common_desktop_cli::backpressure",
      "queue": "bounded_keyed_fifo",
      "enqueue": "O(1)_average",
      "dequeue": "O(1)_average",
      "cancel": "O(1)_average",
      "retry_after_precedence": true,
      "deadline_propagation": true,
      "local_remaining_authoritative": false,
      "wire_authority": "ORESoftware/ores-middleware + generated HTTP/RPC clients",
      "quota_state_authority": "server_coordinator"
    },
    "release-activation-policy": {
      "rust_module": "ores_common_desktop_daemon::hot_reload_policy",
      "transaction_authority": "runtime-generation/rust",
      "selection_mode": "capability-negotiated-fail-closed",
      "process_generation_fallback_required": true,
      "code_middleware_routes_one_transaction": true,
      "native_dynamic_library_hot_swap_allowed": false,
      "shared_drain_limits_with_hot_reload": true,
      "in_process_certification_required": true
    }
  }
}
